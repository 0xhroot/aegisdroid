#!/usr/bin/env bash
#
# AegisDroid - Quick Launch Script
# Usage: ./run
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"
PYTHON="$VENV_DIR/bin/python"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo -e "${GREEN}    ___  ________  _______   ____  ________  ___${NC}"
echo -e "${GREEN}   /   |/_  __/ / / /   | |  / _ \\/ __/ __ \\/ _ \\${NC}"
echo -e "${GREEN}  / /| | / / / /_/ / /| | | / /_/ / /_/ /_/ /  __/${NC}"
echo -e "${GREEN} / ___ |/ / / __  / ___ | |/ _, _/ __/ _, _/ /${NC}"
echo -e "${GREEN}/_/  |_/_/ /_/ /_/_/  |_|____/_/ /_/ /_/ |_|/${NC}"
echo ""

if [ ! -d "$VENV_DIR" ]; then
    echo -e "${YELLOW}Virtual environment not found. Setting up...${NC}"
    echo ""

    echo -e "${GREEN}[1/2] Creating virtual environment...${NC}"
    python3 -m venv "$VENV_DIR"

    echo -e "${GREEN}[2/2] Installing AegisDroid and dependencies...${NC}"
    "$PYTHON" -m pip install --quiet --upgrade pip
    "$PYTHON" -m pip install --quiet "$SCRIPT_DIR"

    echo ""
    echo -e "${GREEN}Setup complete!${NC}"
    echo ""
fi

exec "$PYTHON" -m aegisdroid.cli.menu "$@"
